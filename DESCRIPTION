Package: mlr3autoiml
Type: Package
Title: Claim-Scoped Diagnostic Gates for Interpretable Machine Learning
Version: 0.1.4
Authors@R: c(
    person("Stefan", "Coors", email = "mail@stefancoors.de", role = c("aut","cre")),
    person("Clara", "Vetter", role = "aut"),
