{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/mlr3autoiml/csdg-card.schema.json",
  "title": "CSDG cards",
  "type": "object",
  "$defs": {
    "claim": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "claim_type",
        "target",
        "semantics",
        "population",
        "analytic_distribution",
        "model_scope",
        "setting_scope",
        "scientific_use",
        "explanation_design",
        "claim_level",
        "use_claim",
        "claim_version",
        "revision_relation",
        "meaning",
        "scope",
        "coordinates"
      ],
      "properties": {
        "claim_level": {
          "enum": [
            "functional",
            "predictive",
            "substantive"
          ]
        },
        "use_claim": {
          "type": "boolean"
        },
        "revision_relation": {
          "enum": [
            "original",
            "same",
            "narrower",
            "broader",
            "incomparable"
          ]
        },
        "coordinates": {
          "type": "object",
          "required": [
            "target",
            "model_scope",
            "semantics",
            "analytic_distribution",
            "scientific_use",
            "explanation_design"
          ],
          "additionalProperties": false,
          "properties": {
            "target": {
              "type": [
                "string",
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "model_scope": {
              "type": [
                "string",
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "semantics": {
              "type": [
                "string",
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "analytic_distribution": {
              "type": [
                "string",
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "scientific_use": {
              "type": [
                "string",
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "explanation_design": {
              "type": [
                "string",
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            }
          }
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "description": "The claim, as it would appear in the article."
        },
        "provenance": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "origin",
            "date",
            "time_basis",
            "selection_basis",
            "evidence_ids"
          ],
          "properties": {
            "origin": {
              "enum": [
                "specified_before_results",
                "retrospective_exploratory",
                "independently_confirmed"
              ]
            },
            "date": {
              "type": "string",
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "time_basis": {
              "type": "string",
              "minLength": 1
            },
            "selection_basis": {
              "type": "string",
              "minLength": 1
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "origin": {
                    "const": "independently_confirmed"
                  }
                },
                "required": [
                  "origin"
                ]
              },
              "then": {
                "properties": {
                  "evidence_ids": {
                    "minItems": 1
                  }
                }
              }
            }
          ],
          "additionalProperties": false
        },
        "meaning": {
          "enum": [
            "model_description",
            "population_claim",
            "causal_claim"
          ]
        },
        "model_scope": {
          "enum": [
            "fitted_model",
            "learner",
            "several_models",
            "unspecified"
          ]
        },
        "scope": {
          "type": "object",
          "required": [
            "quantity",
            "model",
            "procedure",
            "data",
            "meaning",
            "use"
          ],
          "properties": {
            "quantity": {},
            "model": {},
            "procedure": {},
            "data": {},
            "meaning": {},
            "use": {}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "measurement": {
      "type": "object",
      "required": [
        "verification"
      ],
      "additionalProperties": true
    },
    "explanation": {
      "type": "object",
      "required": [
        "method_ids",
        "scope",
        "target"
      ],
      "additionalProperties": true
    },
    "config": {
      "type": "object",
      "required": [
        "seed",
        "resampling",
        "stability",
        "generalization",
        "criteria"
      ],
      "additionalProperties": true
    }
  },
  "properties": {
    "claim": {
      "$ref": "#/$defs/claim"
    },
    "measurement": {
      "$ref": "#/$defs/measurement"
    },
    "explanation": {
      "$ref": "#/$defs/explanation"
    },
    "config": {
      "$ref": "#/$defs/config"
    }
  },
  "required": [
    "claim",
    "measurement",
    "explanation",
    "config"
  ],
  "additionalProperties": true
}
