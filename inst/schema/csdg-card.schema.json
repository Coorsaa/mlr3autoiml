{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/mlr3autoiml/csdg-card.schema.json",
  "title": "CSDG cards",
  "type": "object",
  "$defs": {
    "claim": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "claim_type",
        "target",
        "semantics",
        "population",
        "analytic_distribution",
        "model_scope",
        "setting_scope",
        "scientific_use",
        "explanation_design",
        "claim_level",
        "use_claim",
        "claim_version",
        "revision_relation",
        "coordinates"
      ],
      "properties": {
        "claim_level": {
          "enum": [
            "functional",
            "predictive",
            "substantive"
          ]
        },
        "use_claim": {
          "type": "boolean"
        },
        "revision_relation": {
          "enum": [
            "original",
            "same",
            "narrower",
            "broader",
            "alternative_or_incomparable"
          ]
        },
        "coordinates": {
          "type": "object",
          "required": [
            "target",
            "model_scope",
            "semantics",
            "analytic_distribution",
            "scientific_use",
            "explanation_design"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "measurement": {
      "type": "object",
      "required": [
        "verification"
      ],
      "additionalProperties": true
    },
    "explanation": {
      "type": "object",
      "required": [
        "method_ids",
        "scope",
        "target"
      ],
      "additionalProperties": true
    },
    "config": {
      "type": "object",
      "required": [
        "seed",
        "resampling",
        "stability",
        "generalization",
        "criteria"
      ],
      "additionalProperties": true
    }
  },
  "properties": {
    "claim": {
      "$ref": "#/$defs/claim"
    },
    "measurement": {
      "$ref": "#/$defs/measurement"
    },
    "explanation": {
      "$ref": "#/$defs/explanation"
    },
    "config": {
      "$ref": "#/$defs/config"
    }
  },
  "required": [
    "claim",
    "measurement",
    "explanation",
    "config"
  ],
  "additionalProperties": true
}
