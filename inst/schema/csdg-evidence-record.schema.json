{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/mlr3autoiml/csdg-evidence-record.schema.json",
  "title": "CSDG evidence record",
  "description": "One entry of a claim record (mlr3autoiml 0.1.6). A required property has the status supported, contradicted, or open; established counterevidence contradicts the property named by gate_id; an unresolved threat leaves it open unless it is contradicted; context never changes the assessment. Records written with the roles of versions up to 0.1.5 are accepted as legacy input without a status.",
  "type": "object",
  "required": [
    "gate_id",
    "applicable",
    "role",
    "availability",
    "result_direction",
    "criterion",
    "criterion_source",
    "criterion_rationale",
    "materiality",
    "adjudication_basis",
    "claim_consequence",
    "rationale"
  ],
  "properties": {
    "gate_id": {
      "description": "Gate of the property; CD is the causal design (not a gate).",
      "enum": [
        "G0a",
        "G0b",
        "G1",
        "G2",
        "G3a",
        "G3b",
        "G4",
        "G5",
        "G6a",
        "G6b",
        "G7a",
        "G7b",
        "CD"
      ]
    },
    "applicable": {
      "description": "Whether the gate applies to the claim.",
      "type": "boolean"
    },
    "role": {
      "enum": [
        "required_property",
        "established_counterevidence",
        "unresolved_threat",
        "context",
        "necessary_requirement",
        "potential_defeater",
        "graded_support",
        "descriptive_context"
      ]
    },
    "status": {
      "description": "Status of a required property.",
      "enum": [
        "supported",
        "contradicted",
        "open",
        null
      ]
    },
    "legacy_role": {
      "enum": [
        "necessary_requirement",
        "potential_defeater",
        "graded_support",
        "descriptive_context",
        null
      ]
    },
    "availability": {
      "enum": [
        "complete",
        "incomplete",
        "unavailable",
        "not_applicable"
      ]
    },
    "result_direction": {
      "enum": [
        "supports",
        "challenges",
        "mixed",
        "descriptive",
        "not_evaluated"
      ]
    },
    "criterion": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "direction": {
          "enum": [
            "minimum",
            "maximum",
            "range",
            "qualitative"
          ]
        }
      },
      "required": [
        "value",
        "direction"
      ],
      "additionalProperties": true
    },
    "criterion_source": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "criterion_rationale": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "materiality": {
      "description": "Deprecated documentary field (0.1.5).",
      "enum": [
        "not_materialized",
        "materialized",
        "not_applicable"
      ]
    },
    "adjudication_basis": {
      "enum": [
        "prespecified_claim_specific_criterion",
        "substantive_adjudication",
        "claim_relevant_sensitivity",
        "other_transparent_rule",
        null
      ]
    },
    "claim_consequence": {
      "description": "Deprecated (0.1.5). On a required property it must agree with the status; on any other entry it is ignored.",
      "enum": [
        "none",
        "retain_exact_claim",
        "revise_claim",
        "exact_claim_not_retained",
        "unresolved"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "varied_component": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "held_constant": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "same_estimand": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "same_estimand_rationale": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "invariance_claimed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "required_property": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "observation": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "relevance_to_proposition": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "variation_status": {
      "enum": [
        "documented_not_verified",
        "not_recorded"
      ]
    },
    "proposition_linkage": {
      "enum": [
        "documented_not_verified",
        "not_recorded"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "criterion": {
            "type": "object"
          }
        },
        "required": [
          "criterion"
        ]
      },
      "then": {
        "properties": {
          "criterion_source": {
            "type": "string",
            "minLength": 1
          },
          "criterion_rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "criterion": {
            "type": "null"
          }
        },
        "required": [
          "criterion"
        ]
      },
      "then": {
        "properties": {
          "criterion_source": {
            "type": "null"
          },
          "criterion_rationale": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "applicable": {
            "const": false
          }
        },
        "required": [
          "applicable"
        ]
      },
      "then": {
        "properties": {
          "availability": {
            "const": "not_applicable"
          },
          "result_direction": {
            "const": "not_evaluated"
          },
          "materiality": {
            "const": "not_applicable"
          },
          "claim_consequence": {
            "const": "none"
          },
          "status": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "applicable": {
            "const": true
          }
        },
        "required": [
          "applicable"
        ]
      },
      "then": {
        "properties": {
          "availability": {
            "not": {
              "const": "not_applicable"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "required_property"
          },
          "applicable": {
            "const": true
          }
        },
        "required": [
          "role",
          "applicable"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "enum": [
              "supported",
              "contradicted",
              "open"
            ]
          }
        },
        "required": [
          "status"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "enum": [
              "established_counterevidence",
              "unresolved_threat",
              "context",
              "necessary_requirement",
              "potential_defeater",
              "graded_support",
              "descriptive_context"
            ]
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "supported"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "availability": {
            "const": "complete"
          },
          "result_direction": {
            "const": "supports"
          },
          "claim_consequence": {
            "enum": [
              "none",
              "retain_exact_claim"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "contradicted"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "availability": {
            "const": "complete"
          },
          "result_direction": {
            "enum": [
              "challenges",
              "mixed"
            ]
          },
          "claim_consequence": {
            "enum": [
              "none",
              "revise_claim",
              "exact_claim_not_retained"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "open"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "claim_consequence": {
            "enum": [
              "none",
              "unresolved"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "established_counterevidence"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "properties": {
          "applicable": {
            "const": true
          },
          "availability": {
            "const": "complete"
          },
          "result_direction": {
            "enum": [
              "challenges",
              "mixed"
            ]
          },
          "claim_consequence": {
            "enum": [
              "none",
              "revise_claim",
              "exact_claim_not_retained"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "unresolved_threat"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "properties": {
          "applicable": {
            "const": true
          },
          "result_direction": {
            "not": {
              "const": "supports"
            }
          },
          "claim_consequence": {
            "enum": [
              "none",
              "unresolved"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "context"
          },
          "claim_consequence": {
            "not": {
              "const": "none"
            }
          }
        },
        "required": [
          "role",
          "claim_consequence"
        ]
      },
      "then": {
        "properties": {
          "legacy_role": {
            "const": "graded_support"
          },
          "claim_consequence": {
            "enum": [
              "retain_exact_claim",
              "unresolved"
            ]
          }
        },
        "required": [
          "legacy_role"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "descriptive_context"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "properties": {
          "claim_consequence": {
            "const": "none"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "materiality": {
            "const": "materialized"
          }
        },
        "required": [
          "materiality"
        ]
      },
      "then": {
        "properties": {
          "role": {
            "enum": [
              "established_counterevidence",
              "potential_defeater"
            ]
          },
          "availability": {
            "const": "complete"
          },
          "result_direction": {
            "enum": [
              "challenges",
              "mixed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "adjudication_basis": {
            "const": "prespecified_claim_specific_criterion"
          }
        },
        "required": [
          "adjudication_basis"
        ]
      },
      "then": {
        "properties": {
          "criterion": {
            "type": "object"
          }
        }
      }
    }
  ]
}
