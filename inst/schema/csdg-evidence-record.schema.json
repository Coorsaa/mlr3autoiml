{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/mlr3autoiml/csdg-evidence-record.schema.json",
  "title": "CSDG evidence record",
  "type": "object",
  "required": [
    "gate_id",
    "applicable",
    "role",
    "availability",
    "result_direction",
    "criterion",
    "criterion_source",
    "criterion_rationale",
    "materiality",
    "adjudication_basis",
    "claim_consequence",
    "rationale"
  ],
  "properties": {
    "gate_id": {
      "enum": [
        "G0a",
        "G0b",
        "G1",
        "G2",
        "G3a",
        "G3b",
        "G4",
        "G5",
        "G6a",
        "G6b",
        "G7a",
        "G7b"
      ]
    },
    "applicable": {
      "description": "Applicability of this module, not the evaluation scope of the proposition itself.",
      "type": "boolean"
    },
    "role": {
      "enum": [
        "necessary_requirement",
        "potential_defeater",
        "graded_support",
        "descriptive_context"
      ]
    },
    "availability": {
      "enum": [
        "complete",
        "incomplete",
        "unavailable",
        "not_applicable"
      ]
    },
    "result_direction": {
      "enum": [
        "supports",
        "challenges",
        "mixed",
        "descriptive",
        "not_evaluated"
      ]
    },
    "criterion": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "direction": {
          "enum": [
            "minimum",
            "maximum",
            "range",
            "qualitative"
          ]
        }
      },
      "required": [
        "value",
        "direction"
      ],
      "additionalProperties": true
    },
    "criterion_source": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "criterion_rationale": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "materiality": {
      "enum": [
        "not_materialized",
        "materialized",
        "not_applicable"
      ]
    },
    "adjudication_basis": {
      "enum": [
        "prespecified_claim_specific_criterion",
        "substantive_adjudication",
        "claim_relevant_sensitivity",
        "other_transparent_rule",
        null
      ]
    },
    "claim_consequence": {
      "description": "Binding record-level constraint: unresolved prevents met; revision blocks retention of the unchanged claim. Retention never overrides another record's blocker or unresolved consequence; none adds no constraint beyond role, availability, and direction.",
      "enum": [
        "none",
        "retain_exact_claim",
        "revise_claim",
        "exact_claim_not_retained",
        "unresolved"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "varied_component": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "held_constant": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "same_estimand": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "invariance_claimed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "same_estimand_rationale": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "required_property": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "observation": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "relevance_to_proposition": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "variation_status": {
      "enum": [
        "not_recorded",
        "documented_not_verified"
      ]
    },
    "proposition_linkage": {
      "enum": [
        "not_recorded",
        "documented_not_verified"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "criterion": {
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "criterion_source": {
            "type": "string",
            "minLength": 1
          },
          "criterion_rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "criterion_source": {
            "type": "null"
          },
          "criterion_rationale": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "applicable": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "availability": {
            "const": "not_applicable"
          },
          "result_direction": {
            "const": "not_evaluated"
          },
          "materiality": {
            "const": "not_applicable"
          },
          "claim_consequence": {
            "const": "none"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "applicable": {
            "const": true
          }
        },
        "required": [
          "applicable"
        ]
      },
      "then": {
        "properties": {
          "availability": {
            "not": {
              "const": "not_applicable"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "not": {
              "const": "potential_defeater"
            }
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "properties": {
          "materiality": {
            "const": "not_applicable"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "applicable": {
            "const": true
          },
          "role": {
            "const": "potential_defeater"
          }
        },
        "required": [
          "applicable",
          "role"
        ]
      },
      "then": {
        "properties": {
          "materiality": {
            "enum": [
              "not_materialized",
              "materialized"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "adjudication_basis": {
            "const": "prespecified_claim_specific_criterion"
          }
        },
        "required": [
          "adjudication_basis"
        ]
      },
      "then": {
        "properties": {
          "criterion": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "materiality": {
            "const": "materialized"
          }
        }
      },
      "then": {
        "properties": {
          "role": {
            "const": "potential_defeater"
          },
          "availability": {
            "const": "complete"
          },
          "result_direction": {
            "enum": [
              "challenges",
              "mixed"
            ]
          },
          "adjudication_basis": {
            "type": "string"
          },
          "claim_consequence": {
            "enum": [
              "revise_claim",
              "exact_claim_not_retained"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "descriptive_context"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "properties": {
          "claim_consequence": {
            "const": "none"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "potential_defeater"
          },
          "materiality": {
            "const": "not_materialized"
          }
        },
        "required": [
          "role",
          "materiality"
        ]
      },
      "then": {
        "properties": {
          "claim_consequence": {
            "enum": [
              "none",
              "unresolved"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claim_consequence": {
            "const": "retain_exact_claim"
          }
        },
        "required": [
          "claim_consequence"
        ]
      },
      "then": {
        "properties": {
          "applicable": {
            "const": true
          },
          "role": {
            "enum": [
              "necessary_requirement",
              "graded_support"
            ]
          },
          "availability": {
            "const": "complete"
          },
          "result_direction": {
            "const": "supports"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claim_consequence": {
            "const": "exact_claim_not_retained"
          }
        },
        "required": [
          "claim_consequence"
        ]
      },
      "then": {
        "properties": {
          "applicable": {
            "const": true
          },
          "availability": {
            "const": "complete"
          }
        },
        "anyOf": [
          {
            "properties": {
              "role": {
                "const": "necessary_requirement"
              },
              "result_direction": {
                "const": "challenges"
              }
            },
            "required": [
              "role",
              "result_direction"
            ]
          },
          {
            "properties": {
              "role": {
                "const": "potential_defeater"
              },
              "materiality": {
                "const": "materialized"
              },
              "result_direction": {
                "enum": [
                  "challenges",
                  "mixed"
                ]
              }
            },
            "required": [
              "role",
              "materiality",
              "result_direction"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "claim_consequence": {
            "const": "revise_claim"
          }
        },
        "required": [
          "claim_consequence"
        ]
      },
      "then": {
        "properties": {
          "applicable": {
            "const": true
          },
          "availability": {
            "const": "complete"
          }
        },
        "anyOf": [
          {
            "properties": {
              "role": {
                "const": "necessary_requirement"
              },
              "result_direction": {
                "enum": [
                  "challenges",
                  "mixed"
                ]
              }
            },
            "required": [
              "role",
              "result_direction"
            ]
          },
          {
            "properties": {
              "role": {
                "const": "potential_defeater"
              },
              "materiality": {
                "const": "materialized"
              },
              "result_direction": {
                "enum": [
                  "challenges",
                  "mixed"
                ]
              }
            },
            "required": [
              "role",
              "materiality",
              "result_direction"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "variation_status": {
            "const": "documented_not_verified"
          }
        },
        "required": [
          "variation_status"
        ]
      },
      "then": {
        "required": [
          "varied_component",
          "held_constant",
          "same_estimand",
          "same_estimand_rationale",
          "invariance_claimed"
        ],
        "properties": {
          "varied_component": {
            "type": "array"
          },
          "held_constant": {
            "type": "array"
          },
          "same_estimand_rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "proposition_linkage": {
            "const": "documented_not_verified"
          }
        },
        "required": [
          "proposition_linkage"
        ]
      },
      "then": {
        "required": [
          "required_property",
          "observation",
          "relevance_to_proposition"
        ],
        "properties": {
          "required_property": {
            "type": "string",
            "minLength": 1
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "relevance_to_proposition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "required_property": {
                "type": "string"
              }
            },
            "required": [
              "required_property"
            ]
          },
          {
            "properties": {
              "observation": {
                "type": "string"
              }
            },
            "required": [
              "observation"
            ]
          },
          {
            "properties": {
              "relevance_to_proposition": {
                "type": "string"
              }
            },
            "required": [
              "relevance_to_proposition"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "required_property",
          "observation",
          "relevance_to_proposition",
          "proposition_linkage"
        ],
        "properties": {
          "required_property": {
            "type": "string",
            "minLength": 1
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "relevance_to_proposition": {
            "type": "string",
            "minLength": 1
          },
          "proposition_linkage": {
            "const": "documented_not_verified"
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "variation_status": {
                "const": "documented_not_verified"
              }
            },
            "required": [
              "variation_status"
            ]
          },
          {
            "anyOf": [
              {
                "properties": {
                  "materiality": {
                    "const": "materialized"
                  }
                },
                "required": [
                  "materiality"
                ]
              },
              {
                "properties": {
                  "claim_consequence": {
                    "enum": [
                      "revise_claim",
                      "exact_claim_not_retained"
                    ]
                  }
                },
                "required": [
                  "claim_consequence"
                ]
              },
              {
                "properties": {
                  "role": {
                    "const": "necessary_requirement"
                  },
                  "result_direction": {
                    "const": "challenges"
                  }
                },
                "required": [
                  "role",
                  "result_direction"
                ]
              }
            ]
          }
        ]
      },
      "then": {
        "required": [
          "required_property",
          "observation",
          "relevance_to_proposition",
          "proposition_linkage"
        ],
        "properties": {
          "required_property": {
            "type": "string",
            "minLength": 1
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "relevance_to_proposition": {
            "type": "string",
            "minLength": 1
          },
          "proposition_linkage": {
            "const": "documented_not_verified"
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "variation_status": {
                "const": "documented_not_verified"
              },
              "same_estimand": {
                "not": {
                  "const": true
                }
              }
            },
            "required": [
              "variation_status",
              "same_estimand"
            ]
          },
          {
            "anyOf": [
              {
                "properties": {
                  "materiality": {
                    "const": "materialized"
                  }
                },
                "required": [
                  "materiality"
                ]
              },
              {
                "properties": {
                  "claim_consequence": {
                    "enum": [
                      "revise_claim",
                      "exact_claim_not_retained"
                    ]
                  }
                },
                "required": [
                  "claim_consequence"
                ]
              },
              {
                "properties": {
                  "role": {
                    "const": "necessary_requirement"
                  },
                  "result_direction": {
                    "const": "challenges"
                  }
                },
                "required": [
                  "role",
                  "result_direction"
                ]
              }
            ]
          }
        ]
      },
      "then": {
        "required": [
          "invariance_claimed"
        ],
        "properties": {
          "invariance_claimed": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "varied_component": {
                "type": "array"
              }
            },
            "required": [
              "varied_component"
            ]
          },
          {
            "properties": {
              "held_constant": {
                "type": "array"
              }
            },
            "required": [
              "held_constant"
            ]
          },
          {
            "properties": {
              "same_estimand": {
                "type": "boolean"
              }
            },
            "required": [
              "same_estimand"
            ]
          },
          {
            "properties": {
              "same_estimand_rationale": {
                "type": "string"
              }
            },
            "required": [
              "same_estimand_rationale"
            ]
          },
          {
            "properties": {
              "invariance_claimed": {
                "type": "boolean"
              }
            },
            "required": [
              "invariance_claimed"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "variation_status"
        ],
        "properties": {
          "variation_status": {
            "const": "documented_not_verified"
          }
        }
      }
    },
    {
      "if": {
        "properties": {"claim_consequence": {"const": "unresolved"}},
        "required": ["claim_consequence"]
      },
      "then": {
        "properties": {"applicable": {"const": true}},
        "not": {
          "properties": {
            "role": {"const": "necessary_requirement"},
            "availability": {"const": "complete"},
            "result_direction": {"const": "challenges"}
          },
          "required": ["role", "availability", "result_direction"]
        }
      }
    }
  ],
  "additionalProperties": false,
  "$comment": "New linkage fields are documentary, not empirical validation. Missing legacy linkage is not recorded; no new certification is implied."
}
