{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/mlr3autoiml/csdg-report-card.schema.json",
  "title": "CSDG report card",
  "description": "Rows of csdg_report_card(): one row per gate (mlr3autoiml 0.1.6). A required gate has a property status (or error); a gate that the claim does not require is context, with status 'context' if it was run and 'not_required' otherwise, and its computed result in diagnostic_status.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "gate_id",
      "gate_name",
      "area",
      "required",
      "plan_role",
      "evidence_role",
      "status",
      "availability",
      "result_direction",
      "criterion",
      "criterion_source",
      "criterion_rationale",
      "rationale",
      "summary"
    ],
    "properties": {
      "gate_id": {
        "enum": [
          "G0a",
          "G0b",
          "G1",
          "G2",
          "G3a",
          "G3b",
          "G4",
          "G5",
          "G6a",
          "G6b",
          "G7a",
          "G7b"
        ]
      },
      "gate_name": {
        "type": "string",
        "minLength": 1
      },
      "area": {
        "enum": [
          "Foundation of the claim",
          "Predictions, explanations, and decisions",
          "Extensions"
        ]
      },
      "evidence_question": {
        "type": [
          "string",
          "null"
        ]
      },
      "required_if": {
        "type": [
          "string",
          "null"
        ]
      },
      "required": {
        "type": "boolean"
      },
      "plan_role": {
        "enum": [
          "required",
          "context",
          "not_required"
        ]
      },
      "evidence_role": {
        "enum": [
          "required_property",
          "context"
        ]
      },
      "status": {
        "enum": [
          "supported",
          "contradicted",
          "open",
          "not_required",
          "error",
          "context"
        ]
      },
      "diagnostic_status": {
        "enum": [
          "supported",
          "contradicted",
          "open",
          "not_required",
          "error"
        ]
      },
      "availability": {
        "enum": [
          "complete",
          "incomplete",
          "unavailable",
          "not_applicable"
        ]
      },
      "result_direction": {
        "enum": [
          "supports",
          "challenges",
          "mixed",
          "descriptive",
          "not_evaluated"
        ]
      },
      "criterion": {
        "type": "string"
      },
      "criterion_source": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1
      },
      "criterion_rationale": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1
      },
      "rationale": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      },
      "applicable": {
        "type": "boolean"
      },
      "applicability": {
        "enum": [
          "applicable",
          "not_applicable"
        ]
      },
      "materiality": {
        "enum": [
          "not_materialized",
          "materialized",
          "not_applicable"
        ]
      },
      "adjudication_basis": {
        "type": [
          "string",
          "null"
        ]
      },
      "claim_consequence": {
        "enum": [
          "none",
          "retain_exact_claim",
          "revise_claim",
          "exact_claim_not_retained",
          "unresolved"
        ]
      }
    },
    "additionalProperties": true,
    "allOf": [
      {
        "if": {
          "properties": {
            "criterion": {
              "maxLength": 0
            }
          },
          "required": [
            "criterion"
          ]
        },
        "then": {
          "properties": {
            "criterion_source": {
              "type": "null"
            },
            "criterion_rationale": {
              "type": "null"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "criterion": {
              "minLength": 1
            },
            "status": {
              "enum": [
                "supported",
                "contradicted"
              ]
            }
          },
          "required": [
            "criterion",
            "status"
          ]
        },
        "then": {
          "properties": {
            "criterion_source": {
              "type": "string",
              "minLength": 1
            },
            "criterion_rationale": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "required": {
              "const": true
            }
          },
          "required": [
            "required"
          ]
        },
        "then": {
          "properties": {
            "evidence_role": {
              "const": "required_property"
            },
            "plan_role": {
              "const": "required"
            },
            "status": {
              "enum": [
                "supported",
                "contradicted",
                "open",
                "error"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "required": {
              "const": false
            }
          },
          "required": [
            "required"
          ]
        },
        "then": {
          "properties": {
            "evidence_role": {
              "const": "context"
            },
            "plan_role": {
              "enum": [
                "context",
                "not_required"
              ]
            },
            "status": {
              "enum": [
                "context",
                "not_required"
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "const": "supported"
            }
          },
          "required": [
            "status"
          ]
        },
        "then": {
          "properties": {
            "availability": {
              "const": "complete"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "const": "error"
            }
          },
          "required": [
            "status"
          ]
        },
        "then": {
          "properties": {
            "availability": {
              "const": "unavailable"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "const": "not_required"
            }
          },
          "required": [
            "status"
          ]
        },
        "then": {
          "properties": {
            "required": {
              "const": false
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "const": "context"
            }
          },
          "required": [
            "status"
          ]
        },
        "then": {
          "properties": {
            "required": {
              "const": false
            },
            "evidence_role": {
              "const": "context"
            },
            "diagnostic_status": {
              "enum": [
                "supported",
                "contradicted",
                "open",
                "error"
              ]
            }
          }
        }
      }
    ]
  }
}
