{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CSDG source access registry",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "access",
      "rationale"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "access": {
        "enum": [
          "public",
          "protected",
          "external"
        ]
      },
      "rationale": {
        "type": "string",
        "minLength": 1
      },
      "path": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1
      },
      "uri": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1
      },
      "sha256": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[0-9a-f]{64}$"
      },
      "dependencies": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "available_aggregate_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "access": {
              "const": "public"
            }
          },
          "required": [
            "access"
          ]
        },
        "then": {
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "access": {
              "const": "protected"
            }
          },
          "required": [
            "access"
          ]
        },
        "then": {
          "anyOf": [
            {
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "required": [
                "uri"
              ],
              "properties": {
                "uri": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      },
      {
        "if": {
          "properties": {
            "access": {
              "const": "external"
            }
          },
          "required": [
            "access"
          ]
        },
        "then": {
          "required": [
            "uri"
          ],
          "properties": {
            "uri": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    ],
    "additionalProperties": true
  },
  "$comment": "Uniqueness, exact public path case, SHA-256, reference existence, and separate dependency/substitution acyclicity are checked by csdg_resolve_sources()."
}
